# Space Monster Todo Environment Configuration
# Copy this file to .env and update values for your environment

# DOMAIN CONFIGURATION
# Replace with your actual domain name
DOMAIN=your-domain.com

# KUBERNETES CONFIGURATION  
KUBE_NAMESPACE=space-monster-todo
KUBE_CONTEXT=your-cluster-context

# APPLICATION CONFIGURATION
APP_NAME=space-monster-todo
IMAGE_NAME=space-monster-todo

# GITHUB ACTIONS CONFIGURATION
# Configure these as repository secrets/variables:
# - DOMAIN (as repository variable)
# - KUBECONFIG (as repository secret)
# - SLACK_WEBHOOK_URL (as repository secret, optional)

# TLS/SSL CONFIGURATION
TLS_SECRET_NAME=space-monster-todo-tls
CERT_ISSUER=letsencrypt-prod

# DEPLOYMENT CONFIGURATION
REPLICAS=2
CPU_REQUEST=100m
CPU_LIMIT=500m
MEMORY_REQUEST=128Mi
MEMORY_LIMIT=256Mi